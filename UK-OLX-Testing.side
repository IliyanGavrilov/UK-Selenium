      "target": "var priceElements = document.querySelectorAll('[data-cy=\"l-card\"] [data-testid=\"ad-price\"]');   var prices = [];   for (var i = 0; i < priceElements.length; i++) {     prices.push(priceElements[i].textContent);   }   return prices;",
