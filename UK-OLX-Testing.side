      "comment": "",
      "command": "executeScript",
      "target": "const priceElements = document.querySelectorAll('.css-blr5zl');   let previousPrice = null; let allValid = true; const result = [];  for (let i = 0; i < priceElements.length; i++) {  \t \tconst element = priceElements[i];     const priceText = element.textContent.trim(); \t \t \tconst cleanText = priceText.replace(/[^\\d,.]/g, '');     const price = parseFloat(cleanText); \t \tconst listing = element.closest('[data-cy=\"l-card\"]');     if (listing && listing.textContent.includes('Промотирана обява')) {         continue;     } \t        if (previousPrice !== null) {         if (price < previousPrice) {             allValid = false;         }     }      result.push(price);      previousPrice = price; }  return allValid;",
