      "comment": "",
      "command": "executeScript",
      "target": " var priceTexts = ${allPriceTexts};   var min =  ${lowerBoundary};   var max =  ${upperBoundary};      for (var i = 0; i < priceTexts.length; i++) {     var numbers = priceTexts[i].match(/\\d+/);     if (numbers) {       var price = parseInt(numbers[0]);       if (price < min || price > max) {         return false;       }     }   }   return true;",
