    }, {
      "id": "6a47bd71-834d-4708-955b-f64263652fe6",
      "comment": "",
      "command": "executeScript",
      "target": "const listings = document.querySelectorAll('[data-cy=\"l-card\"]'); let allValid = true;  for (let listing of listings) {     if (listing.textContent.includes('Промотирана обява')) {         continue;     }          const paramValues = listing.querySelectorAll('[data-testid=\"param-value\"]');          let foundAdidas = false, foundWhite = false, foundPolyester = false;          for (let param of paramValues) {         const value = param.textContent.trim();                  if (value === ${brand}) {             foundAdidas = true;         } else if (value === ${color}) {             foundWhite = true;         } else if (value === ${material}) {             foundPolyester = true;         }     }          if (!foundAdidas || !foundWhite || !foundPolyester) {         allValid = false;         break;     } }  return allValid;",
      "targets": [],
      "value": "result"
    }, {
      "id": "d487dfb2-d7ee-4f0c-b1b8-eb6b7c293b55",
      "comment": "",
      "command": "assert",
      "target": "result",
      "targets": [],
      "value": "true"
    }]
