    }, {
      "id": "7bdc9fd3-6fe4-4652-ab09-1915fa1fd4d4",
      "comment": "",
      "command": "executeScript",
      "target": "const timeElements = document.querySelectorAll('.css-1h96hyx'); const now = new Date(); const currTime = now.getHours() * 60 + now.getMinutes();  function parseTime(text) {         const timeMatch = text.match(/(\\d{1,2}):(\\d{2})/);         if (timeMatch) {             return parseInt(timeMatch[1]) * 60 + parseInt(timeMatch[2]);         }          return 0; }  let previousTime = currTime; let allValid = true; for (let i = 0; i < timeElements.length; i++) {     const element = timeElements[i];     const timeText = element.textContent.trim(); \tconst listing = element.closest('[data-cy=\"l-card\"]');     if (listing && listing.textContent.includes('Промотирана обява')) {         continue;     } \t \t \t     const elementTime = parseTime(timeText);             if (elementTime > previousTime) {         allValid = false;         break;     }          previousTime = elementTime; }  return allValid;",
      "targets": [],
      "value": "valid"
    }, {
      "id": "ad20299c-cdaf-47b6-8e7b-7da34849bf62",
      "comment": "",
      "command": "assert",
      "target": "valid",
      "targets": [],
      "value": "true"
    }]
