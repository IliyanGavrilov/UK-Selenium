    }, {
      "id": "f5ed42e1-ba30-402b-ba62-a69b8334baa6",
      "comment": "",
      "command": "executeScript",
      "target": " const listings = document.querySelectorAll('[data-cy=\"l-card\"]');     let allValid = true;          for (let listing of listings) {         if (listing.textContent.includes('Промотирана обява')) {             continue;         } \t\t         const paramsList = listing.querySelector('[data-testid=\"parameters-list\"]'); \t\tif (!paramsList) { continue;} \t\tconst paramRows = paramsList.querySelectorAll('[data-testid^=\"param-row-\"]'); \t\t         const elements = listing.querySelectorAll('.css-1ixkkbm');         let foundState = false, foundSeasonality = false, foundSuitableFor = false, foundType = false, foundMpsType = false;                 for (let row of paramRows) {             const paramName = row.querySelector('[data-testid^=\"param-name-\"]');             const paramValue = row.querySelector('.css-1ixkkbm');              \t\t\t   if (!paramName || !paramValue) continue; \t\t\t    \t\t\tconst name = paramName.textContent.trim();             const value = paramValue.textContent.trim(); \t\t\t             if (name === 'Състояние' && value.includes('${condition}')) {                 foundState = true;             } else if (name === 'Сезонност' && value.includes('${seasonal}')) {                 foundSeasonality = true;             } else if (name === 'Подходящ за' && value.includes('${appropriateFor}')) {                 foundSuitableFor = true;             } else if (name === 'Тип' && value.includes('${type}')) {                 foundType = true;             } else if (name === 'Вид МПС' && value.includes('${typeMPS}')) {                 foundMpsType = true;             }         }                  if (!foundState || !foundSeasonality || !foundSuitableFor || !foundType || !foundMpsType) {             allValid = false;             break;         }     }          return allValid;",
      "targets": [],
      "value": "result"
    }, {
      "id": "4beaae44-ce08-4d86-8e73-e29bde718fee",
      "comment": "",
      "command": "assert",
      "target": "result",
      "targets": [],
      "value": "true"
    }]
